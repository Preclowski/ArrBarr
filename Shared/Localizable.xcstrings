    "Reports warnings/errors across your arrs and whether download clients are reachable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports warnings/errors across your arrs and whether download clients are reachable."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłasza ostrzeżenia i błędy ze wszystkich arrów oraz to, czy klienci pobierania są osiągalni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet Warnungen und Fehler aus deinen arrs und ob Download-Clients erreichbar sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa de advertencias y errores en todos tus arrs y si los clientes de descarga son accesibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale les avertissements et erreurs sur vos arrs et vérifie si les clients de téléchargement sont joignables."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporteert waarschuwingen/fouten in al jouw arrs en of downloadclients bereikbaar zijn."
          }
        }
      },
      "comment": "Intent description (Siri / Shortcuts)"
    },
