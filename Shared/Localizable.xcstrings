          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienststatus prüfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar estado del servicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier l'état des services"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicestatus controleren"
          }
        }
      },
      "comment": "Intent title (Siri / Shortcuts)"
