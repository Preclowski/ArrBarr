{
  "sourceLanguage": "en",
  "version": "1.1",
  "strings": {
    "Show download queue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show download queue"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż kolejkę pobierania"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download-Queue anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar cola de descargas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la file de téléchargement"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadwachtrij tonen"
          }
        }
      },
      "comment": "Intent title (Siri / Shortcuts)"
    },
    "Says what Sonarr and Radarr are currently downloading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says what Sonarr and Radarr are currently downloading."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaje, co Sonarr i Radarr aktualnie pobierają."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt, was Sonarr und Radarr gerade herunterladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica qué están descargando actualmente Sonarr y Radarr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique ce que Sonarr et Radarr téléchargent actuellement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft aan wat Sonarr en Radarr momenteel downloaden."
          }
        }
      },
      "comment": "Intent description (Siri / Shortcuts)"
    },
    "Show upcoming releases": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show upcoming releases"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż nadchodzące premiery"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstehende Veröffentlichungen anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar próximos estrenos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les sorties à venir"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankomende releases tonen"
          }
        }
      },
      "comment": "Intent title (Siri / Shortcuts)"
    },
    "Says the next upcoming episodes, movies and albums.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says the next upcoming episodes, movies and albums."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaje najbliższe nadchodzące odcinki, filmy i albumy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt die nächsten anstehenden Episoden, Filme und Alben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica los próximos episodios, películas y álbumes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonce les prochains épisodes, films et albums à venir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft de volgende geplande afleveringen, films en albums."
          }
        }
      },
      "comment": "Intent description (Siri / Shortcuts)"
    },
    "Pause all downloads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause all downloads"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj wszystkie pobierania"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Downloads pausieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar todas las descargas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause tous les téléchargements"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle downloads pauzeren"
          }
        }
      },
      "comment": "Intent title (Siri / Shortcuts)"
    },
    "Pauses every active download (where a download client is configured).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses every active download (where a download client is configured)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuje każde aktywne pobieranie (jeśli skonfigurowano klienta pobierania)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert jeden aktiven Download (sofern ein Download-Client konfiguriert ist)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa todas las descargas activas (donde haya un cliente de descarga configurado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en pause chaque téléchargement actif (si un client de téléchargement est configuré)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeert elke actieve download (wanneer er een downloadclient is geconfigureerd)."
          }
        }
      },
      "comment": "Intent description (Siri / Shortcuts)"
    },
    "Resume all downloads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume all downloads"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznów wszystkie pobierania"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Downloads fortsetzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar todas las descargas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre tous les téléchargements"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle downloads hervatten"
          }
        }
      },
      "comment": "Intent title (Siri / Shortcuts)"
    },
    "Resumes every paused download (where a download client is configured).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumes every paused download (where a download client is configured)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznawia każde wstrzymane pobieranie (jeśli skonfigurowano klienta pobierania)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt jeden pausierten Download fort (sofern ein Download-Client konfiguriert ist)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda todas las descargas pausadas (donde haya un cliente de descarga configurado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend chaque téléchargement en pause (si un client de téléchargement est configuré)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervat elke gepauzeerde download (wanneer er een downloadclient is geconfigureerd)."
          }
        }
      },
      "comment": "Intent description (Siri / Shortcuts)"
    },
    "Search to add": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search to add"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj i dodaj"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen und hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar y añadir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher pour ajouter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken om toe te voegen"
          }
        }
      },
      "comment": "Intent title (Siri / Shortcuts)"
    },
    "Search Sonarr/Radarr and open ArrBarr at the results to add something.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Sonarr/Radarr and open ArrBarr at the results to add something."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuje w Sonarr/Radarr i otwiera ArrBarr na wynikach, by coś dodać."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht in Sonarr/Radarr und öffnet ArrBarr mit den Ergebnissen zum Hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en Sonarr/Radarr y abre ArrBarr en los resultados para añadir contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche dans Sonarr/Radarr et ouvre ArrBarr sur les résultats pour ajouter quelque chose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt in Sonarr/Radarr en opent ArrBarr met de resultaten om iets toe te voegen."
          }
        }
      },
      "comment": "Intent description (Siri / Shortcuts)"
    },
    "Check service health": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
