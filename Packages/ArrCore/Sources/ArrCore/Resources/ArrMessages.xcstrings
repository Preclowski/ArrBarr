    "[%@] is not a valid local path. You may need a Remote Path Mapping.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] is not a valid local path. You may need a Remote Path Mapping."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] ist kein gültiger lokaler Pfad. Eventuell ist eine Remote-Pfadzuordnung nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] no es una ruta local válida. Puede que necesites un mapeo de ruta remota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] n'est pas un chemin local valide. Un mappage de chemin distant est peut-être nécessaire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] is geen geldig lokaal pad. Mogelijk is een externe padtoewijzing nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] nie jest prawidłową ścieżką lokalną. Może być potrzebne mapowanie ścieżki zdalnej."
          }
        }
      }
    },
    "[%@] is not a valid local path. You may need a Remote Path Mapping. Check the download troubleshooting entry on the wiki for details.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] is not a valid local path. You may need a Remote Path Mapping. Check the download troubleshooting entry on the wiki for details."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] ist kein gültiger lokaler Pfad. Eventuell ist eine Remote-Pfadzuordnung nötig. Details stehen im Wiki unter Download-Fehlerbehebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] no es una ruta local válida. Puede que necesites un mapeo de ruta remota. Consulta la sección de solución de problemas de descargas de la wiki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] n'est pas un chemin local valide. Un mappage de chemin distant est peut-être nécessaire. Consultez la section de dépannage des téléchargements du wiki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] is geen geldig lokaal pad. Mogelijk is een externe padtoewijzing nodig. Zie het onderdeel over downloadproblemen op de wiki."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@] nie jest prawidłową ścieżką lokalną. Może być potrzebne mapowanie ścieżki zdalnej. Szczegóły opisuje wiki w części o problemach z pobieraniem."
          }
        }
      }
    }
