    "Artist name mismatch, automatic import is not possible. Check the download troubleshooting entry on the wiki for common causes.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artist name mismatch, automatic import is not possible. Check the download troubleshooting entry on the wiki for common causes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Künstlername stimmt nicht überein, automatischer Import ist nicht möglich. Häufige Ursachen stehen im Wiki unter Download-Fehlerbehebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del artista no coincide; no es posible la importación automática. Consulta las causas habituales en la sección de solución de problemas de descargas de la wiki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de l'artiste ne correspond pas, import automatique impossible. Consultez la section de dépannage des téléchargements du wiki pour les causes courantes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Artiestnaam komt niet overeen, automatische import is niet mogelijk. Zie het onderdeel over downloadproblemen op de wiki voor veelvoorkomende oorzaken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa wykonawcy się nie zgadza, automatyczny import jest niemożliwy. Częste przyczyny opisuje wiki w części o problemach z pobieraniem."
          }
        }
      }
    },
