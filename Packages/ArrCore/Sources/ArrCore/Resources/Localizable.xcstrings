      "comment": "Tooltip/description in onboarding"
    },
    "settings.arrbarrStaysOutOf.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr stays out of your Dock and shows active downloads at a glance. **Left-click** the icon to open the popover. **Right-click** for Add, Refresh, Settings — every action also has a keyboard shortcut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr nie zaśmieca Doca i pokazuje aktywne pobrania na pierwszy rzut oka. **Lewy klik** na ikonie otwiera popover. **Prawy klik** wywołuje Dodaj, Odśwież, Ustawienia — każda akcja ma też skrót klawiaturowy."
          }
        }
      },
      "comment": "Tooltip/description in settings"
    },
