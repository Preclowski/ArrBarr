    "Will query your indexers and start a download if a release matches.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will query your indexers and start a download if a release matches."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpyta indeksery i rozpocznie pobieranie, jeśli znajdzie pasujące wydanie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt deine Indexer ab und startet einen Download, wenn eine Veröffentlichung passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultará tus indexadores e iniciará una descarga si hay una versión coincidente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrogera vos indexeurs et lancera un téléchargement si une version correspond."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorzoekt je indexers en start een download als er een release overeenkomt."
          }
        }
      }
    },
