    "settings.detachFromTheMenu.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detach from the menu bar into a standalone window with a Dock icon. Closing the window returns it to the Dock."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odepnij od paska menu do osobnego okna z ikoną w Docku. Zamknięcie okna chowa je z powrotem do Docka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Menüleiste in ein eigenständiges Fenster mit Dock-Icon ablösen. Beim Schließen des Fensters kehrt es ins Dock zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa de la barra de menús en una ventana independiente con icono en el Dock. Cerrar la ventana la devuelve al Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détacher de la barre des menus dans une fenêtre autonome avec icône dans le Dock. Fermer la fenêtre la renvoie dans le Dock."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Losmaken van de menubalk als een zelfstandig venster met een Dock-pictogram. Het venster sluiten zet het terug in de Dock."
