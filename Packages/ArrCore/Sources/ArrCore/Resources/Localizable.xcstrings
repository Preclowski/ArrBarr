    "queue.addSabnzbdQbittorrentNzbget.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add SABnzbd, qBittorrent, NZBGet, Transmission, rTorrent, or Deluge to pause and resume directly from the queue. Most features work fine without it — your arr already handles the heavy lifting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj SABnzbd, qBittorrent, NZBGet, Transmission, rTorrent lub Deluge, aby pauzować i wznawiać prosto z kolejki. Większość funkcji działa bez tego — Twój arr zajmie się resztą."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SABnzbd, qBittorrent, NZBGet, Transmission, rTorrent oder Deluge hinzufügen, um direkt aus der Queue zu pausieren und fortzusetzen. Die meisten Funktionen funktionieren ohne — dein arr erledigt die schwere Arbeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade SABnzbd, qBittorrent, NZBGet, Transmission, rTorrent o Deluge para pausar y reanudar directamente desde la cola. La mayoría de funciones funcionan sin esto — tu arr ya se encarga del trabajo duro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez SABnzbd, qBittorrent, NZBGet, Transmission, rTorrent ou Deluge pour mettre en pause et reprendre directement depuis la file d'attente. La plupart des fonctionnalités marchent sans — votre arr gère déjà le plus gros."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg SABnzbd, qBittorrent, NZBGet, Transmission, rTorrent of Deluge toe om direct vanuit de wachtrij te pauzeren en hervatten. De meeste functies werken prima zonder — jouw arr doet het zware werk."
          }
        }
      },
      "comment": "Tooltip/description in queue"
    },
    "settings.addTmdbApiKey.tooltip": {
