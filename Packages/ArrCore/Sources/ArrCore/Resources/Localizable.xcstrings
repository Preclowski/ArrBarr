            "value": "Le serveur a renvoyé une réponse illisible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server stuurde een onleesbaar antwoord."
          }
        }
      }
    },
    "The server rejected %@ — the download may have already finished or been removed.": {
      "comment": "%@ is the refused NZBGet command name, e.g. \"pause\"",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected %@ — the download may have already finished or been removed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer odrzucił %@ — pobieranie mogło się już zakończyć albo zostało usunięte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat %@ abgelehnt — der Download ist vielleicht schon fertig oder wurde entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó %@ — puede que la descarga ya haya terminado o se haya eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a rejeté %@ — le téléchargement est peut-être déjà terminé ou a été supprimé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft %@ afgewezen — de download is mogelijk al klaar of al verwijderd."
          }
        }
      }
    },
    "XML-RPC fault in response to %@": {
