    "settings.showWarnings.footer": {
      "comment": "Explains the show-warnings toggle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: show errors and warnings from your arrs. Off: errors only."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone: pokazuje błędy i ostrzeżenia z arrów. Wyłączone: tylko błędy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein: Fehler und Warnungen der arrs anzeigen. Aus: nur Fehler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: muestra errores y advertencias de tus arrs. Desactivado: solo errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : affiche les erreurs et les avertissements de vos arrs. Désactivé : erreurs uniquement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan: toont fouten en waarschuwingen van je arrs. Uit: alleen fouten."
          }
        }
      }
    },
