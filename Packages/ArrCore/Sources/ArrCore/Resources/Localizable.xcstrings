    "onboarding.arrbarrNowShowsA.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr now shows a brief intro on first launch and after major updates so you know what's new. Reopen it any time from Settings → General."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr pokazuje teraz krótkie wprowadzenie przy pierwszym uruchomieniu i po dużych aktualizacjach, dzięki czemu wiesz, co nowego. Otwórz je ponownie w dowolnej chwili z Ustawienia → Ogólne."
          }
