    "chat.aNewChatTab.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new Chat tab lets you ask questions in plain language — find a show, check what's coming this week, add a movie. Works with Apple Intelligence (macOS 26+) or any OpenAI-compatible API. Set up under Settings → AI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa zakładka Czat pozwala zadawać pytania zwykłym językiem — znajdź serial, sprawdź co wychodzi w tym tygodniu, dodaj film. Działa z Apple Intelligence (macOS 26+) lub dowolnym API zgodnym z OpenAI. Konfiguracja w Ustawienia → AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Chat-Tab ermöglicht Fragen in natürlicher Sprache — eine Serie finden, nachsehen was diese Woche kommt, einen Film hinzufügen. Funktioniert mit Apple Intelligence (macOS 26+) oder einer OpenAI-kompatiblen API. Einrichten unter Einstellungen → KI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nueva pestaña Chat te permite hacer preguntas en lenguaje natural — encuentra una serie, comprueba qué hay esta semana, añade una película. Funciona con Apple Intelligence (macOS 26+) o cualquier API compatible con OpenAI. Configúralo en Ajustes → IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouvel onglet Tchat vous permet de poser des questions en langage naturel — trouver une série, voir ce qui sort cette semaine, ajouter un film. Fonctionne avec Apple Intelligence (macOS 26+) ou toute API compatible OpenAI. À configurer dans Réglages → IA."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een nieuw Chat-tabblad kun je vragen stellen in gewone taal — zoek een serie, bekijk wat er deze week uitkomt, voeg een film toe. Werkt met Apple Intelligence (macOS 26+) of een OpenAI-compatibele API. Instellen via Instellingen → AI."
          }
        }
      },
      "comment": "Tooltip/description in chat"
    },
