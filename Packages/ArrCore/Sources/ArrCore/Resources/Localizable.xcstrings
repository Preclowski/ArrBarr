        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure Radarr in Settings to save picks to your library — add-actions will open TMDB instead."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj Radarr w Ustawieniach, by zapisywać wybory do biblioteki — akcje „Dodaj” będą otwierać TMDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radarr in den Einstellungen konfigurieren, um Auswahlen in deine Bibliothek zu speichern — Hinzufügen öffnet sonst TMDB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura Radarr en Ajustes para guardar selecciones en tu biblioteca — las acciones «Añadir» abrirán TMDB en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez Radarr dans les Réglages pour enregistrer les sélections dans votre bibliothèque — les actions « Ajouter » ouvriront TMDB à la place."
