    "settings.toolsAreOnlyRegistered.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools are only registered for services you have configured — with no Sonarr/Radarr set up, the server exposes none."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia są rejestrowane tylko dla skonfigurowanych usług — bez ustawionego Sonarr/Radarr serwer nie udostępnia żadnych."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools werden nur für konfigurierte Dienste registriert — ohne eingerichtetes Sonarr/Radarr stellt der Server keine bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas solo se registran para los servicios que hayas configurado — sin Sonarr/Radarr configurado, el servidor no expone ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils ne sont enregistrés que pour les services configurés — sans Sonarr/Radarr configuré, le serveur n'en expose aucun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools worden alleen geregistreerd voor services die je hebt geconfigureerd — zonder Sonarr/Radarr stelt de server niets beschikbaar."
          }
        }
      },
      "comment": "Tooltip/description in settings"
    },
