    "Add a TMDB key to let chat search by actor, genre, and decade.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj klucz TMDB, aby czat mógł szukać po aktorze, gatunku i dekadzie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen TMDB-Schlüssel hinzu, damit der Chat nach Schauspieler, Genre und Jahrzehnt suchen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una clave TMDB para que el chat busque por actor, género y década."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une clé TMDB pour permettre au chat de rechercher par acteur, genre et décennie."
