    "onboarding.seeWhatSAiring.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what's airing tonight, get notified about new grabs, and surface indexer issues before they become a problem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co leci dziś wieczorem, otrzymuj powiadomienia o nowych pobraniach i wykrywaj problemy z indeksami zanim staną się kłopotem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was heute Abend läuft, erhalte Benachrichtigungen über neue Downloads und erkenne Indexer-Probleme, bevor sie zum Problem werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve qué se emite esta noche, recibe notificaciones sobre nuevas descargas y detecta problemas con los indexadores antes de que sean un problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce qui passe ce soir, recevez des notifications pour les nouveaux téléchargements et détectez les problèmes d'indexeurs avant qu'ils ne deviennent un souci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat er vanavond te zien is, ontvang meldingen over nieuwe downloads en signaleer indexerproblemen voordat ze een probleem worden."
          }
        }
      },
      "comment": "Tooltip/description in onboarding"
    },
