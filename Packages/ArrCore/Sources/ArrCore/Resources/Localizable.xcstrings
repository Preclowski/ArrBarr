            "state": "translated",
            "value": "ArrBarr se reiniciará ahora para aplicar el cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr va redémarrer maintenant pour appliquer le changement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr uruchomi się ponownie, aby zastosować zmianę."
          }
        }
      }
    },
    "ArrBarr will relaunch now to load demo content.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr wird jetzt neu gestartet, um Demoinhalte zu laden."
          }
        },
