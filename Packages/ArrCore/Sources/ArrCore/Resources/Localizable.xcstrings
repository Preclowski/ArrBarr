  "strings": {
    "Close window": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close window"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij okno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer la fenêtre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Venster sluiten"
          }
        }
      }
    },
    "Cancel this download?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this download?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulować pobieranie?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download abbrechen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar esta descarga?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler ce téléchargement ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze download annuleren?"
          }
        }
      }
    },
    "This will remove the download from the client.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove the download from the client."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunie to pobieranie z klienta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Download aus dem Client entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará la descarga del cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera le téléchargement du client."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de download uit de client verwijderd."
          }
        }
      }
    },
    "This will remove the season pack from the client.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove the season pack from the client."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunie to paczkę sezonu z klienta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Staffelpaket aus dem Client entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará el paquete de temporada del cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera le pack de saison du client."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt het seizoenspakket uit de client verwijderd."
          }
        }
      }
    },
