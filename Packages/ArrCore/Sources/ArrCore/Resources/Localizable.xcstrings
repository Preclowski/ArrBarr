    "3 movies in Radarr and a season in Sonarr.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Filme in Radarr und eine Staffel in Sonarr."
          }
        },
