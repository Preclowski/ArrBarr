    "Apple Intelligence is unavailable. Try turning it on in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence jest niedostępne. Spróbuj je włączyć w Ustawieniach systemowych."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist nicht verfügbar. Versuche es in den Systemeinstellungen zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está disponible. Prueba a activarlo en Ajustes del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n'est pas disponible. Essayez de l'activer dans les Réglages système."
          }
        }
      }
    },
