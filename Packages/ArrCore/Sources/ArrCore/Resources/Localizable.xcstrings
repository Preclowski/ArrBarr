    "onboarding.ifYouVeConfigured.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you've configured Lidarr, music artists now show up in search results and the AI chat. Add an artist the same way you'd add a series or movie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli skonfigurowałeś Lidarra, artyści muzyczni pojawiają się teraz w wynikach wyszukiwania i czacie AI. Dodaj artystę tak samo jak serial czy film."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Lidarr konfiguriert hast, erscheinen Musikkünstler jetzt in den Suchergebnissen und im KI-Chat. Einen Künstler genauso hinzufügen wie eine Serie oder einen Film."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si has configurado Lidarr, los artistas musicales aparecen ahora en los resultados de búsqueda y en el chat IA. Añade un artista igual que añadirías una serie o película."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez configuré Lidarr, les artistes musicaux apparaissent désormais dans les résultats de recherche et le tchat IA. Ajoutez un artiste de la même façon qu'une série ou un film."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je Lidarr hebt geconfigureerd, verschijnen muziekartiesten nu in zoekresultaten en de AI-chat. Voeg een artiest toe op dezelfde manier als een serie of film."
          }
        }
      },
      "comment": "Tooltip/description in onboarding"
    },
