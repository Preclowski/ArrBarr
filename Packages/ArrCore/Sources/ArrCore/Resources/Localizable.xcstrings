    "onboarding.addYourExistingArr.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your existing arr services in Settings — ArrBarr polls live queue, history, and health from each one."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj istniejące usługi arr w ustawieniach — ArrBarr na bieżąco pobiera kolejkę, historię i stan każdej z nich."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deine arr-Dienste in den Einstellungen hinzu — ArrBarr fragt live Queue, Verlauf und Status von jedem ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tus servicios arr en Ajustes — ArrBarr consulta en tiempo real la cola, el historial y el estado de cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos services arr dans les Réglages — ArrBarr interroge en temps réel la file d'attente, l'historique et l'état de chacun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg jouw bestaande arr-services toe in Instellingen — ArrBarr haalt live de wachtrij, geschiedenis en status van elk op."
          }
        }
      },
      "comment": "Tooltip/description in onboarding"
    },
