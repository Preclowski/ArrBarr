    "onboarding.arrbarrNowShowsA.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr now shows a brief intro on first launch and after major updates so you know what's new. Reopen it any time from Settings → General."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr pokazuje teraz krótkie wprowadzenie przy pierwszym uruchomieniu i po dużych aktualizacjach, dzięki czemu wiesz, co nowego. Otwórz je ponownie w dowolnej chwili z Ustawienia → Ogólne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr zeigt jetzt beim ersten Start und nach größeren Updates eine kurze Einführung, damit du weißt, was neu ist. Jederzeit wieder öffnen unter Einstellungen → Allgemein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr muestra ahora una breve introducción al primer arranque y tras actualizaciones importantes para que sepas qué hay de nuevo. Ábrela de nuevo cuando quieras desde Ajustes → General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr affiche maintenant une brève introduction au premier lancement et après les mises à jour importantes pour vous informer des nouveautés. Rouvrez-la à tout moment depuis Réglages → Général."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr toont nu een korte introductie bij de eerste start en na grote updates, zodat je weet wat er nieuw is. Open het op elk moment opnieuw via Instellingen → Algemeen."
          }
        }
      },
      "comment": "Tooltip/description in onboarding"
    },
    "settings.arrbarrStaysOutOf.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr stays out of your Dock and shows active downloads at a glance. **Left-click** the icon to open the popover. **Right-click** for Add, Refresh, Settings — every action also has a keyboard shortcut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr nie zaśmieca Doca i pokazuje aktywne pobrania na pierwszy rzut oka. **Lewy klik** na ikonie otwiera popover. **Prawy klik** wywołuje Dodaj, Odśwież, Ustawienia — każda akcja ma też skrót klawiaturowy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr bleibt aus deinem Dock heraus und zeigt aktive Downloads auf einen Blick. **Linksklick** auf das Icon öffnet das Popover. **Rechtsklick** für Hinzufügen, Aktualisieren, Einstellungen — jede Aktion hat auch einen Tastaturkurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr no ocupa espacio en el Dock y muestra las descargas activas de un vistazo. **Clic izquierdo** en el icono para abrir el panel. **Clic derecho** para Añadir, Actualizar, Ajustes — cada acción tiene también un atajo de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr reste hors de votre Dock et affiche les téléchargements actifs d'un coup d'œil. **Clic gauche** sur l'icône pour ouvrir le panneau. **Clic droit** pour Ajouter, Actualiser, Réglages — chaque action a aussi un raccourci clavier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr blijft buiten je Dock en toont actieve downloads in één oogopslag. **Linksklik** op het pictogram om het pop-upvenster te openen. **Rechtsklik** voor Toevoegen, Vernieuwen, Instellingen — elke actie heeft ook een sneltoets."
          }
        }
      },
      "comment": "Tooltip/description in settings"
    },
    "queue.arrbarrStaysOutOf.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr stays out of your Dock and shows active downloads at a glance. Click the icon for the popover; right-click for quick options."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr nie zajmuje miejsca w Docku i pokazuje aktywne pobierania w mgnieniu oka. Kliknij ikonę, aby otworzyć okno; kliknij prawym, aby zobaczyć szybkie opcje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr bleibt aus deinem Dock heraus und zeigt aktive Downloads auf einen Blick. Icon anklicken für das Popover; Rechtsklick für Schnelloptionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr no ocupa espacio en el Dock y muestra las descargas activas de un vistazo. Haz clic en el icono para abrir el panel; clic derecho para opciones rápidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr reste hors de votre Dock et affiche les téléchargements actifs d'un coup d'œil. Cliquez sur l'icône pour le panneau ; clic droit pour les options rapides."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr blijft uit je Dock en toont actieve downloads in één oogopslag. Klik op het pictogram voor het pop-upvenster; rechtsklik voor snelle opties."
          }
        }
      },
      "comment": "Tooltip/description in queue"
    },
