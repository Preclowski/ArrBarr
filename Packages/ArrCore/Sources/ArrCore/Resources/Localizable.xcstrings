    "settings.keepYourServersPreferences.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your servers, preferences, and saved keys in sync across your devices. Keys are stored in your encrypted iCloud Keychain."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj serwery, preferencje i zapisane klucze na wszystkich urządzeniach. Klucze są przechowywane w zaszyfrowanym Pęku kluczy iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server, Einstellungen und gespeicherte Schlüssel auf allen Geräten synchron halten. Schlüssel werden im verschlüsselten iCloud-Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus servidores, preferencias y claves guardadas sincronizados entre tus dispositivos. Las claves se almacenan en tu Llavero de iCloud cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos serveurs, préférences et clés enregistrées synchronisés sur tous vos appareils. Les clés sont stockées dans votre Trousseau iCloud chiffré."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je servers, voorkeuren en opgeslagen sleutels gesynchroniseerd op al jouw apparaten. Sleutels worden opgeslagen in jouw versleutelde iCloud Sleutelhanger."
          }
        }
      },
      "comment": "Tooltip/description in settings"
    },
