    "onboarding.itSFreeAnd.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's free and open-source. A star on GitHub helps other people find it — and means a lot. Thanks for trying it out!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr jest darmowy i open source. Gwiazdka na GitHubie pomaga innym go znaleźć — i wiele dla nas znaczy. Dzięki, że go testujesz!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ArrBarr ist kostenlos und Open Source. Ein Stern auf GitHub hilft anderen, es zu finden — und bedeutet uns viel. Danke, dass du es ausprobierst!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gratuito y de código abierto. Una estrella en GitHub ayuda a que otras personas lo encuentren — y significa mucho. ¡Gracias por probarlo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est gratuit et open source. Une étoile sur GitHub aide les autres à le trouver — et ça compte beaucoup. Merci de l'avoir essayé !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is gratis en open source. Een ster op GitHub helpt anderen het te vinden — en betekent veel. Bedankt voor het uitproberen!"
          }
        }
      },
      "comment": "Tooltip/description in onboarding"
    },
