    "onboarding.reorderSectionsHideWhat.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorder sections, hide what you don't need, tweak refresh intervals, and pick your language in Settings. Show only what matters to you."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień kolejność sekcji, ukryj to, czego nie potrzebujesz, dostosuj częstotliwość odświeżania i wybierz język w ustawieniach. Pokazuj tylko to, co ważne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschnitte neu anordnen, nicht benötigte ausblenden, Aktualisierungsintervalle anpassen und Sprache in den Einstellungen wählen. Zeig nur, was wichtig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena las secciones, oculta lo que no necesites, ajusta los intervalos de actualización y elige tu idioma en Ajustes. Muestra solo lo que importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganisez les sections, masquez ce dont vous n'avez pas besoin, ajustez les intervalles d'actualisation et choisissez votre langue dans les Réglages. Affichez uniquement ce qui compte pour vous."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herorden secties, verberg wat je niet nodig hebt, pas verversingsintervallen aan en kies je taal in Instellingen. Toon alleen wat voor jou belangrijk is."
          }
        }
      },
      "comment": "Tooltip/description in onboarding"
    },
