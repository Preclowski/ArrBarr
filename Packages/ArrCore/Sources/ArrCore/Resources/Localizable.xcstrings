            "value": "Clicking a Spotlight result shows the title inside ArrBarr. Turn off to open its page in Radarr/Sonarr in your browser instead."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknięcie wyniku ze Spotlight pokazuje tytuł w ArrBarr. Wyłącz, aby zamiast tego otwierać stronę pozycji w Radarr/Sonarr w przeglądarce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick auf ein Spotlight-Ergebnis zeigt den Titel in ArrBarr. Deaktivieren, um stattdessen seine Seite in Radarr/Sonarr im Browser zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pulsar un resultado de Spotlight, el título se muestra dentro de ArrBarr. Desactívalo para abrir su página en Radarr/Sonarr en el navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur un résultat Spotlight affiche le titre dans ArrBarr. Désactivez pour ouvrir sa page dans Radarr/Sonarr dans le navigateur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikken op een Spotlight-resultaat toont de titel in ArrBarr. Schakel uit om in plaats daarvan de pagina in Radarr/Sonarr in de browser te openen."
          }
        }
      }
    },
