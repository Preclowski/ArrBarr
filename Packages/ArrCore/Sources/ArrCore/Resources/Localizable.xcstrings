    "settings.clearIntentsCache.tooltip": {
      "extractionState": "manual",
      "comment": "Siri/Shortcuts settings: clear Spotlight intents",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes ArrBarr's library entries from Spotlight (fixes stale icons). They re-index automatically."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa pozycje biblioteki ArrBarr ze Spotlight (naprawia stałe ikony). Zindeksują się ponownie automatycznie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt ArrBarrs Bibliothekseinträge aus Spotlight (behebt veraltete Symbole). Sie werden automatisch neu indiziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las entradas de la biblioteca de ArrBarr de Spotlight (corrige iconos obsoletos). Se reindexan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les entrées de la bibliothèque ArrBarr de Spotlight (corrige les icônes obsolètes). Elles sont réindexées automatiquement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert ArrBarrs bibliotheekvermeldingen uit Spotlight (lost verouderde iconen op). Ze worden automatisch opnieuw geïndexeerd."
          }
        }
      }
    },
