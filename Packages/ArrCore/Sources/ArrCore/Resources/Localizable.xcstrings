    "settings.hostPortToBind.tooltip": {
      "extractionState": "manual",
      "comment": "Tooltip/description in settings",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "host:port to bind the server to. Use 0.0.0.0 to accept connections on every network interface, or 127.0.0.1 to keep it local."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "host:port, na którym nasłuchuje serwer. Użyj 0.0.0.0, aby przyjmować połączenia ze wszystkich interfejsów sieciowych, albo 127.0.0.1, aby pozostać lokalnie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "host:port, an den der Server gebunden wird. 0.0.0.0 verwenden, um Verbindungen auf allen Netzwerkschnittstellen zu akzeptieren, oder 127.0.0.1, um es lokal zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "host:puerto al que vincular el servidor. Usa 0.0.0.0 para aceptar conexiones en todas las interfaces de red, o 127.0.0.1 para mantenerlo local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "host:port auquel lier le serveur. Utilisez 0.0.0.0 pour accepter les connexions sur toutes les interfaces réseau, ou 127.0.0.1 pour rester en local."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "host:poort waaraan de server wordt gekoppeld. Gebruik 0.0.0.0 om verbindingen op alle netwerkinterfaces te accepteren, of 127.0.0.1 om het lokaal te houden."
          }
        }
      }
    },
