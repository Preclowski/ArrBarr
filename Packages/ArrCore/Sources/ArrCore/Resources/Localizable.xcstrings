    "settings.realtimeHealthCheck.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long a silent realtime connection is trusted before ArrBarr falls back to polling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak długo ArrBarr ufa milczącemu połączeniu na żywo, zanim wróci do odpytywania."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange einer stillen Echtzeitverbindung vertraut wird, bevor ArrBarr wieder abfragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo se confía en una conexión en tiempo real silenciosa antes de volver al sondeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle une connexion temps réel silencieuse reste fiable avant le retour à l'interrogation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoelang een stille realtime-verbinding wordt vertrouwd voordat ArrBarr weer gaat pollen."
          }
        }
      },
      "comment": "Footnote under the realtime health check picker"
    },
