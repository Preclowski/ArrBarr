          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat eine unlesbare Antwort gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor envió una respuesta ilegible."
          }
        },
