            "state": "translated",
            "value": "TMDB nie znalazł nowych filmów pasujących do Twoich filtrów. Spróbuj wyczyścić część z nich."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB hat keine neuen Filme für deine Filter gefunden. Versuche einige zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB no encontró nuevas películas que coincidan con tus filtros. Prueba a eliminar alguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB n'a trouvé aucun nouveau film correspondant à vos filtres. Essayez d'en effacer certains."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB heeft geen nieuwe films gevonden die bij jouw filters passen. Probeer enkele filters te verwijderen."
          }
        }
