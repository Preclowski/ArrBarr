    "settings.tapAddToSiri.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Add to Siri” to set a phrase. The same actions appear in the Shortcuts app and Spotlight — no setup needed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij „Dodaj do Siri”, aby ustawić frazę. Te same akcje są w aplikacji Skróty i w Spotlight — bez konfiguracji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Zu Siri hinzufügen\" tippen, um eine Phrase festzulegen. Dieselben Aktionen erscheinen in der Kurzbefehle-App und in Spotlight — keine Einrichtung nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Añadir a Siri» para establecer una frase. Las mismas acciones aparecen en la app Atajos y en Spotlight — sin configuración adicional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur « Ajouter à Siri » pour définir une phrase. Les mêmes actions apparaissent dans l'app Raccourcis et Spotlight — aucune configuration nécessaire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op \"Voeg toe aan Siri\" om een zin in te stellen. Dezelfde acties staan in de Opdrachten-app en Spotlight — geen installatie nodig."
          }
        }
      },
      "comment": "Tooltip/description in settings"
    },
