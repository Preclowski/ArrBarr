    "chat.quizPrompt.movies": {
      "extractionState": "manual",
      "comment": "Prompt sent to the LLM when starting a quiz from the chat hero card",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give me a quiz of popular movies to swipe through — a dozen-plus that aren't in my library yet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób mi quiz z filmów — kilkanaście popularnych filmów, których jeszcze nie mam w bibliotece."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib mir ein Quiz mit beliebten Filmen zum Durchswipen — ein Dutzend, die noch nicht in meiner Bibliothek sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dame un quiz de películas populares para deslizar — una docena que aún no tengo en mi biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne-moi un quiz de films populaires à faire défiler — une douzaine que je n'ai pas encore dans ma bibliothèque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef me een quiz met populaire films om doorheen te swipen — een tiental die ik nog niet in mijn bibliotheek heb."
          }
        }
      }
    },
